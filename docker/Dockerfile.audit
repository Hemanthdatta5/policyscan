# Tracker audit worker: Chromium in an isolated container. No DB, no app secrets.
FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

COPY pyproject.toml ./
COPY app ./app
COPY ml ./ml
RUN pip install --no-cache-dir ".[audit]" "playwright==1.49.0"

# Playwright image ships a non-root user
USER pwuser
EXPOSE 9000
CMD ["uvicorn", "app.audit_worker:app", "--host", "0.0.0.0", "--port", "9000"]
