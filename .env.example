# Copy to .env and edit. Never commit .env.
POLICYSCAN_ENV=dev
POLICYSCAN_DATABASE_URL=sqlite:///./policyscan.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POLICYSCAN_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
POLICYSCAN_MODEL_PATH=models/baseline-v0
POLICYSCAN_FETCH_TIMEOUT_SECONDS=10
POLICYSCAN_FETCH_MAX_BYTES=2000000
POLICYSCAN_FETCH_MAX_REDIRECTS=5
